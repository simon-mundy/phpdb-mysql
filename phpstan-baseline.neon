			count: 1
			path: src/Driver.php

		-
			message: '#^Instanceof between PhpDb\\Mysql\\Statement and PhpDb\\Adapter\\Driver\\DriverAwareInterface will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
